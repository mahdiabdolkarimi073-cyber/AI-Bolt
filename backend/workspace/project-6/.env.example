# Personal AI IDE — Frontend environment variables.
# Copy this file to `.env` and adjust. None of these are secrets — they are
# public runtime config embedded in the browser bundle. Real API keys live
# ONLY in backend/.env on the local machine and are never exposed to the frontend.

# Base URL of the local FastAPI backend. Leave EMPTY to run in browser fallback
# mode (localStorage persistence, no file access). Set it only when running the
# Python backend on your machine.
# Example: http://localhost:8000
VITE_API_BASE_URL=

# Default AI provider when no settings have been saved yet.
# One of: gemini | groq | cerebras | openrouter
VITE_DEFAULT_PROVIDER=gemini

# --- Supabase (pre-provisioned; do not edit) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
