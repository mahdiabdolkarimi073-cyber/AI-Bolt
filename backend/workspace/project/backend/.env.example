# Local backend configuration. Copy to .env and fill in real values.
# This file stays on your machine — never commit the real .env.

# Workspace root: all project folders must live inside this directory.
# The backend will refuse any file operation that escapes it.
WORKSPACE_ROOT=./workspace

# SQLite database location (relative to backend/).
DATABASE_URL=sqlite:///./data/paide.db

# CORS: the frontend origin that may call this backend.
FRONTEND_ORIGIN=http://localhost:5173

# Server
HOST=127.0.0.1
PORT=8000

# --- Credential encryption (REQUIRED for API key storage) ---
# Generate a key with:  python -m app.crypto generate-key
# Paste the output here. NEVER commit this value. NEVER put it in the SQLite DB.
# If you lose this key, stored credentials CANNOT be recovered.
PAIDE_ENC_KEY=

# --- Local endpoint policy (SSRF protection) ---
# Allow plain HTTP for explicitly local development endpoints. Remote providers
# must always use HTTPS. Leave false unless you develop against a local server.
ALLOW_LOCAL_HTTP=false
# Comma-separated allowlist of loopback hosts for custom local endpoints.
LOCAL_ENDPOINT_HOSTS=localhost,127.0.0.1,::1

# --- Legacy provider API keys (optional, backward compatibility) ---
# Prefer adding keys through Settings → AI Connections instead. Keys here are
# only read by the old single-provider flow. Never exposed to the browser.
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
